</head>
    <style>
    .disable-page {
        pointer-events: none;
        opacity: 0.5;
    }

    /* Allow popup interaction */
    #ForcePasswordModal {
        pointer-events: auto !important;
    }

    #ForcePasswordModal .modal-dialog {
        pointer-events: auto !important;
    }
</style>
<body>
    <form id="form1" runat="server" önunload="disableBackButton()" onkeydown="return (event.keyCode!=13); ">
        <!-- Force Change Password Modal -->
<div class="modal fade"
     id="ForcePasswordModal"
     tabindex="-1"
     role="dialog"
     data-backdrop="static"
     data-keyboard="false">

    <div class="modal-dialog modal-sm">
        <div class="modal-content">

            <div class="modal-header bg-danger">
                <h4 class="modal-title" style="color:white">
                    Change Password
                </h4>
            </div>

            <div class="modal-body text-center">

                <h4 class="text-danger">
                    Password Change Required
                </h4>

                <p>
                    Your password has expired.<br />
                    Please change your password before using the application.
                </p>

            </div>

            <div class="modal-footer">

                <button type="button"
                        id="btnForcePwd"
                        class="btn btn-primary">
                    OK
                </button>

            </div>

        </div>
    </div>

</div>
        <div class="top-header-main">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#myNavbar-tabs">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand" href="#">
                    <img src="Image/educate-girls-logo.png" class="img-responsive logo-img" />

                </a>
            </div>

            <div class="top-header-1">
                <h2> Educate Girls-PMS</h2>
            </div>
            <div class="top-header-2">
                <nav class="navbar">
                    <div  class="collapse navbar-collapse" id="myNavbar-tabs">
                        <ul class="nav navbar-nav super-admin-btn">
                            <%--<li role="presentation"><a href="#"><i class="fa fa-bell-o"></i><span class="badge">
                                1</span></a></li>--%>
                            <li class="dropdown">
                                <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                    <span class="fa fa-user"></span>
                                    <asp:Label ID="lblUser" runat="server" Text="Label"></asp:Label>
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a href="javascript:void(0)"><span class="text-danger">Employee name: </span><span
                                        class=" text-success">
                                        <asp:Label ID="lblEmpName" runat="server" Text="Label" /></span></a></li>
                                    <li><a href="javascript:void(0)"><span class="text-danger">Role: </span><span class=" text-success">
                                        <asp:Label ID="lblRole" runat="server" Text="Label" /></span></a></li>
                                   <li>  <asp:LinkButton ID="btnlogout" runat="server" CssClass="btn btn-default btn-md" OnClick="btnlogout_Click">
                                          <span aria-hidden="true" class="fa fa-user"></span>&nbsp;Logout
                    </asp:LinkButton></li>
                                </ul>
                            </li>
                        </ul>
                        <div id="myNavbar" runat="server" class="clsallmenuslist">
                        </div>
                    </div>

                </nav>
            </div>
        </div>







        <div class="inner-section">

            <div>
                <asp:ToolkitScriptManager ID="ToolkitScriptManager1" runat="server">
                </asp:ToolkitScriptManager>
            </div>
            <div>
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
            <asp:UpdateProgress ID="UpdWt" runat="server" DisplayAfter="1">
                <ProgressTemplate>
                    <div class="ModalPopupBGstar" id="jjj" runat="server" style="vertical-align: middle; z-index: 9999999999999; left: -1px; top: -1px; position: absolute; width: 100%; height: 100%;"
                        align="center">
                        <asp:Image ID="img" ImageUrl="Images/progress2.gif" Style="position: absolute; top: 35%;"
                            runat="server" valign="middle" />
                    </div>
                </ProgressTemplate>
            </asp:UpdateProgress>

        </div>



    </form>

    <script src="js/security.js"></script>
<script>
    function ShowForcePasswordPopup() {

        // Disable whole page except popup
        $(".top-header-main").addClass("disable-page");
        $(".inner-section").addClass("disable-page");

        $("#ForcePasswordModal").modal({
            backdrop: 'static',
            keyboard: false
        });

        $("#ForcePasswordModal").modal("show");
    }

    
  
        function DisableMenu() {

            // Disable all menu links
            $(".clsallmenuslist a").each(function () {

                $(this).css({
                    "pointer-events": "none",
                    "cursor": "not-allowed",
                    "opacity": "0.5"
                });

                $(this).removeAttr("href");

                $(this).click(function (e) {
                    e.preventDefault();
                    return false;
                });

            });

        // Disable dropdowns
        $(".dropdown-toggle").removeAttr("data-toggle");

        // Disable Logout
        $("#<%= btnlogout.ClientID %>").css({
            "pointer-events": "none",
        "cursor": "not-allowed",
        "opacity": "0.5"
        });
    }

   <%-- function ShowForcePasswordPopup() {

        // Disable all menus
        $(".clsallmenuslist").css({
            "pointer-events": "none",
            "opacity": "0.5"
        });

        // Disable Logout
        $("#<%= btnlogout.ClientID %>").css({
            "pointer-events": "none",
            "opacity": "0.5"
        });

        // Show Popup
        $("#ForcePasswordModal").modal({
            backdrop: 'static',
            keyboard: false
        });

        $("#ForcePasswordModal").modal("show");
    }--%>

    // OK button
    $(document).on("click", "#btnForcePwd", function () {

        alert("Button Clicked");

        window.location.href = "Frm_Change_Password.aspx";
    });

</script>

</body>

